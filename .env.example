# ==========================================
# VisionInspect AI - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="VisionInspect AI"
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production_32bytes_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vision_admin
POSTGRES_PASSWORD=vision_pass123
POSTGRES_DB=visioninspect_db
DATABASE_URL=postgresql://vision_admin:vision_pass123@localhost:5432/visioninspect_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Admin Seed
FIRST_SUPERUSER_EMAIL=admin@visioninspect.ai
FIRST_SUPERUSER_PASSWORD=Admin@123
FIRST_SUPERUSER_NAME="System Administrator"

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
